# Vite environment variables for production
# Copy this to .env.production before deploying
# These values are baked into the bundle at build time

# API backend URL (replace with your deployed API domain)
VITE_API_URL=https://api.yourdomain.com

# Optional: API CORS origin (set on the API side, not used by frontend directly)
# VITE_CORS_ORIGINS=https://www.yourdomain.com

# Map tile API (default: OpenFreeMap)
# To use a different provider, uncomment and configure:
# VITE_MAPBOX_TOKEN=your_mapbox_token
# VITE_MAP_STYLE=mapbox://styles/your-style-id

# Dashboard refresh interval (seconds)
VITE_DASHBOARD_REFRESH_INTERVAL=60

# Run metadata display (auto-detected from manifest, override if needed)
# VITE_DEFAULT_RUN_ID=abc123def456

# Feature flags (optional)
# VITE_ENABLE_LIVE_OSM=true

# MapLibre / Mapbox telemetry (set to false to disable)
# VITE_MAP_TELEMETRY=false

# Production environment indicator (auto-detected)
# VITE_ENV=production
