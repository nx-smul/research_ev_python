# Production environment variables for web dashboard
# Build-time configuration - set these before running `npm run build`
# Do NOT commit actual secrets; use a secrets manager or deployment service

# Backend API URL - MUST be set for production
VITE_API_URL=https://api.yourdomain.com

# Optional: override default run selection
# VITE_DEFAULT_RUN_ID=your-run-id

# Optional: disable real-time auto-refresh (set to false)
VITE_DASHBOARD_REFRESH_INTERVAL=60

# Optional: feature flags
# VITE_ENABLE_LIVE_OSM=true
